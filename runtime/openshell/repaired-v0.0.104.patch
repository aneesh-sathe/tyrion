diff --git a/crates/openshell-driver-vm/scripts/openshell-vm-sandbox-init.sh b/crates/openshell-driver-vm/scripts/openshell-vm-sandbox-init.sh
index 14dbc046..bb25828e 100644
--- a/crates/openshell-driver-vm/scripts/openshell-vm-sandbox-init.sh
+++ b/crates/openshell-driver-vm/scripts/openshell-vm-sandbox-init.sh
@@ -677,6 +677,32 @@ run_post_overlay_setup() {
     mount -t cgroup2 cgroup2 "$(root_path /sys/fs/cgroup)" 2>/dev/null &
     wait
 
+    # Every sandbox VM is a single security boundary. Put PID 1 and all of
+    # its descendants in a dedicated cgroup, then expose that cgroup as the
+    # guest root so the supervisor and workloads observe the enforced limit.
+    # Fail closed because a missing process ceiling violates the boundary.
+    local cgroup_root sandbox_cgroup
+    cgroup_root="$(root_path /sys/fs/cgroup)"
+    sandbox_cgroup="${cgroup_root}/openshell-sandbox"
+    if ! grep -qw pids "${cgroup_root}/cgroup.controllers"; then
+        ts "FATAL: cgroup v2 pids controller unavailable"
+        exit 1
+    fi
+    mkdir "$sandbox_cgroup"
+    echo "$$" > "${sandbox_cgroup}/cgroup.procs"
+    echo +pids > "${cgroup_root}/cgroup.subtree_control"
+    if [ ! -f "${sandbox_cgroup}/pids.max" ]; then
+        ts "FATAL: cgroup v2 pids.max unavailable"
+        exit 1
+    fi
+    echo 256 > "${sandbox_cgroup}/pids.max"
+    mount --bind "$sandbox_cgroup" "$cgroup_root"
+    if [ "$(cat "${cgroup_root}/pids.max")" != 256 ]; then
+        ts "FATAL: failed to enforce the 256-process ceiling"
+        exit 1
+    fi
+    ts "enforced 256-process cgroup ceiling"
+
     # Allow nftables LOG rules to work in non-init network namespaces.
     # Without this, the kernel's nf_log_syslog silently suppresses output
     # from the sandbox's network namespace.
